params {
    outdir = 'results'

    // ── Reference paths ──────────────────────────────────────────────────────
    // Set these to the absolute paths on your HPC before running.
    genome_fasta = params.genome_fasta ?: '/path/to/GRCh38/genome.fa'
    star_index   = params.star_index   ?: '/path/to/GRCh38/star_index'
    bwa_index    = params.bwa_index    ?: '/path/to/GRCh38/bwa_index/genome'
    // ─────────────────────────────────────────────────────────────────────────

    // Conda Environments
    multiqc_env  = 'multiqc_env'

    // Module names — adjust to match your HPC module system
    modules {
        sra         = 'SRA/3.0.0'
        bowtie2     = 'bowtie2/2.2.7'
        fastp       = 'fastp/0.23.2'
        trim_galore = 'trim_galore/0.6.6'
        cutadapt    = 'cutadapt/2.1'
        fastqc      = 'fastqc/0.11.5'
        salmon      = 'salmon/0.11.1'
        samtools    = 'samtools/1.21'
        star        = 'star/2.7.3a'
        subread     = 'subread/2.0.5'
        gatk        = 'gatk/4.2.6.1'
    }
}

process {
    errorStrategy = 'retry'
    maxRetries    = 3
}

profiles {
    cluster {
        process {
            executor = 'slurm'
            queue    = 'general'

            withName: 'DOWNLOAD_SRA' {
                cpus          = 2
                memory        = '8 GB'
                time          = '12h'
                maxForks      = 10
                errorStrategy = 'retry'
                maxRetries    = 3
            }
            withName: 'FASTQC_.*' {
                cpus   = 4
                memory = '8 GB'
                time   = '4h'
            }
            withName: 'TRIM_GALORE' {
                cpus          = 8
                memory        = '32 GB'
                time          = '24h'
                errorStrategy = 'retry'
                maxRetries    = 2
            }
            withName: 'TRIM_FASTP' {
                cpus   = 4
                memory = '16 GB'
                time   = '8h'
            }
            withName: 'TRIM_CUTADAPT' {
                cpus   = 4
                memory = '16 GB'
                time   = '8h'
            }
            withName: 'MULTIQC_.*' {
                cpus   = 2
                memory = '8 GB'
                time   = '2h'
            }
            withName: 'ALIGN_DNA' {
                cpus   = 16
                memory = '64 GB'
                time   = '24h'
            }
            withName: 'ALIGN_RNA' {
                cpus   = 12
                memory = '80 GB'
                time   = '24h'
            }
            withName: 'INDEX_DNA' {
                cpus   = 8
                memory = '32 GB'
                time   = '4h'
            }
        }
    }
}
